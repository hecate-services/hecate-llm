%% Test-only sys.config for `rebar3 ct'. Deliberately separate from
%% config/sys.config.src (the real deploy config): that file's
%% `${HECATE_REALM}' placeholder is only ever substituted by relx's
%% RELX_REPLACE_OS_VARS mechanism at actual release boot, which
%% `rebar3 ct' does not perform -- pointing ct_opts at it directly loads
%% the literal, wrong-length placeholder string, and
%% hecate_om_identity:load_realm/0's byte-length-guarded clauses have no
%% catch-all for "present but malformed", only for `undefined' -- so it
%% crashes the whole app on boot (confirmed live) instead of gracefully
%% staying dark. No `realm' key here at all reproduces the graceful
%% "dark, no mesh" path the test suite has always relied on.
[
    {hecate_llm, [
        {http_port,      8470},
        {data_dir,       "/var/lib/hecate-llm/data"},
        {event_store_id, llm_store}
    ]},

    {serve_llm, [
        {ollama_url, "http://localhost:11434"}
    ]},

    {hecate_om, [
        {service_cert_path, "/etc/hecate/secrets/service-cert.pem"},
        {station_socket,    "/run/macula/station.sock"},
        {health_port, undefined}
    ]}
].
