[
    {hecate_llm, [
        {http_port,      8470},
        {data_dir,       "/var/lib/hecate-llm/data"},
        {event_store_id, llm_store}
    ]},

    {serve_llm, [
        %% Preserved from the prior serve_llm app — provider defaults.
        {ollama_url, "http://localhost:11434"}
    ]},

    {hecate_om, [
        {service_cert_path, "/etc/hecate/secrets/service-cert.pem"},
        {station_socket,    "/run/macula/station.sock"},
        %% Explicitly `undefined', not omitted: hecate_om.app.src bakes
        %% in {health_port, 8470} as the APP'S OWN packaged default, so
        %% simply leaving the key out of this sys.config does NOT clear
        %% it -- sys.config only overrides keys it names, it doesn't
        %% blank an app's own compiled-in defaults. Confirmed live:
        %% application:get_env(hecate_om, health_port) still returned
        %% {ok, 8470} with the key omitted entirely. hecate_llm_sup's
        %% own cowboy listener (http_port above) already folds
        %% `hecate_om_health_handler:routes()' into its dispatch table
        %% alongside the `/api/v1/*' admin routes -- see its own
        %% moduledoc ("serves /health + /api/v1/*") -- so hecate_om's
        %% OWN separate listener for the exact same /health route is
        %% pure duplication, and its default port (8470, see
        %% hecate_om_health.erl's moduledoc) collides with this app's
        %% own http_port default, failing as eaddrinuse on every boot.
        {health_port, undefined}
    ]}
].
