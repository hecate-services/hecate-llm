%% -*- mode: erlang -*-
%% rebar3 configuration for hecate-llm

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {hecate_om, {git, "https://codeberg.org/hecate-services/hecate-om.git", {branch, "main"}}},

    {reckon_db,    "1.6.3"},
    {evoq,         "1.13.1"},
    {reckon_evoq,  "1.5.1"},
    {reckon_gater, "1.3.1"},

    {cowboy,  "2.12.0"},
    {hackney, "1.20.1"},
    {jsx,     "3.1.0"}
]}.

{relx, [
    {release, {hecate_llm, "0.1.0"}, [
        hecate_llm,

        hecate_om,
        reckon_db,
        evoq,
        reckon_evoq,

        llm,
        chat_to_llm,
        stream_chat_with_llm,
        manage_providers,
        detect_llms,
        check_llm_health,
        get_available_llms_page,
        report_llm_status,
        track_llm_usage,
        project_llm_usage
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [hecate_llm]}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]}
]}.
