%% -*- mode: erlang -*-
%% rebar3 configuration for hecate-llm

{erl_opts, [debug_info, warnings_as_errors]}.

{project_plugins, [rebar3_lint]}.

{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["src/**/*.erl", "apps/*/src/**/*.erl"], ruleset => macula_min}
    ]}
]}.

{deps, [
    {hecate_om, "~> 0.23"},

    {evoq, "~> 1.23"},
    {reckon_evoq, "~> 2.7"},

    {cowboy,  "~> 2.12.0"},
    {hackney, "~> 1.20"},
    {jsx,     "~> 3.1.0"}
]}.

{relx, [
    {release, {hecate_llm, "0.1.0"}, [
        hecate_llm,

        hecate_om,
        reckon_db,
        evoq,
        reckon_evoq,

        llm,
        chat_to_llm,
        stream_chat_with_llm,
        manage_providers,
        detect_llms,
        check_llm_health,
        get_available_llms_page,
        report_llm_status,
        track_llm_usage,
        project_llm_usage
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    %% Explicit, not relying on relx's own filename-convention fallback:
    %% `sys_config_src' (not plain `sys_config') is what actually makes
    %% relx run RELX_REPLACE_OS_VARS substitution over `${HECATE_REALM}'
    %% etc. at release boot. This was a real, separate deployment gap
    %% found while first standing this service up: config/sys.config
    %% was a plain, unsubstituted file with no `realm' key in it AT
    %% ALL -- hecate_om_identity:load_realm/0 would have found nothing
    %% configured and the service would boot dark, never joining the
    %% mesh, regardless of what HECATE_REALM the deploy environment set.
    {sys_config_src, "config/sys.config.src"}
]}.

{shell, [
    {config, "config/sys.config.src"},
    {apps, [hecate_llm]}
]}.

%% Without this, `rebar3 ct' boots every app on its own app.src defaults
%% only -- sys.config(.src) is silently never read at all. Confirmed
%% live: hecate_om.app.src bakes in {health_port, 8470}, and every
%% override attempted in sys.config (omitting the key, then explicitly
%% {health_port, undefined}) left `application:get_env(hecate_om,
%% health_port)' returning {ok, 8470} under `rebar3 ct' regardless,
%% until this.
%%
%% Deliberately config/test.config, NOT config/sys.config.src: rebar3 ct
%% does not perform relx's RELX_REPLACE_OS_VARS substitution, so pointing
%% this at the real deploy config would load `${HECATE_REALM}' as a
%% literal, wrong-length binary -- confirmed live, this crashes the
%% whole app on boot (hecate_om_identity:load_realm/0's byte-length
%% guards have no catch-all for "present but malformed", only for
%% `undefined'), not the graceful "stay dark" degrade it looks like it
%% should be. test.config carries no `realm' key at all, reproducing
%% that graceful path on purpose.
{ct_opts, [
    {sys_config, ["config/test.config"]}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]}
]}.
