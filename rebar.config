%% -*- mode: erlang -*-
%% rebar3 configuration for hecate-llm

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {hecate_om, "~> 0.22"},

    {evoq, "~> 1.23"},
    {reckon_evoq, "~> 2.7"},

    {cowboy,  "~> 2.12.0"},
    {hackney, "~> 1.20"},
    {jsx,     "~> 3.1.0"}
]}.

{relx, [
    {release, {hecate_llm, "0.1.0"}, [
        hecate_llm,

        hecate_om,
        reckon_db,
        evoq,
        reckon_evoq,

        llm,
        chat_to_llm,
        stream_chat_with_llm,
        manage_providers,
        detect_llms,
        check_llm_health,
        get_available_llms_page,
        report_llm_status,
        track_llm_usage,
        project_llm_usage
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [hecate_llm]}
]}.

%% Without this, `rebar3 ct' boots every app on its own app.src defaults
%% only -- config/sys.config is silently never read at all (relx DOES
%% pick it up by filename convention for the release build, so this gap
%% was invisible outside test runs). Confirmed live: hecate_om.app.src
%% bakes in {health_port, 8470}, and every override attempted in
%% config/sys.config (omitting the key, then explicitly {health_port,
%% undefined}) left `application:get_env(hecate_om, health_port)'
%% returning {ok, 8470} under `rebar3 ct' regardless, until this.
{ct_opts, [
    {sys_config, ["config/sys.config"]}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]}
]}.
