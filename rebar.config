%% -*- mode: erlang -*-
%% rebar3 configuration for hecate-llm

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {hecate_om, "~> 0.6"},

    {evoq, "~> 1.23"},
    {reckon_evoq, "~> 2.7"},

    {cowboy,  "~> 2.12.0"},
    {hackney, "~> 1.20"},
    {jsx,     "~> 3.1.0"}
]}.

{relx, [
    {release, {hecate_llm, "0.1.0"}, [
        hecate_llm,

        hecate_om,
        reckon_db,
        evoq,
        reckon_evoq,

        llm,
        chat_to_llm,
        stream_chat_with_llm,
        manage_providers,
        detect_llms,
        check_llm_health,
        get_available_llms_page,
        report_llm_status,
        track_llm_usage,
        project_llm_usage
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [hecate_llm]}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]}
]}.
